#!/bin/sh
#2026 machiner opencode
# George launcher. One file, both layouts:
#   - repo/clone: george.py lives next to bin/ ($here resolution)
#   - installed copy at ~/bin/george: george.py lives in ~/george
# X/wayland: ONE alacritty window split by tmux -
#   pane 0 (top)    = george dashboard
#   pane 1 (bottom) = a real built-in terminal (see RESPAWN_SHELL below)
# Ctrl+t (tmux bare -n binding) flips focus between the panes from either
# side; george's ▶ TERM chip focuses (or resurrects) the terminal pane.
#
# On a bare console tty (no X/wayland) tmux needs no alacritty either -
# the console itself is the terminal. The tty build below (bottom of this
# file) hosts the SAME architecture: pane 0 = george, pane 1 = the
# immortal shell, Ctrl+t flips - so george always has a built-in terminal,
# in X and in a tty alike. A bare `python3 george.py` run (no launcher)
# remains the minimal fallback; its TERM chip then opens the command line.
set -eu

here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ -f "$here/../george.py" ]; then
    GEORGE_PY="$here/../george.py"
else
    here="$HOME/george/bin"
    GEORGE_PY="$HOME/george/george.py"
fi

# Vendored button scripts ride along: put this repo's bin/ (the repo
# clone) or ~/george/bin (installed copy) first on PATH so the shipped
# buttons.toml works on any machine without a separate install step.
[ -d "$here" ] && PATH="$here:$PATH"
export PATH

if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ] && [ "$#" -gt 0 ]; then
    # One-shot runs (e.g. --self-test) never need tmux; on a console they
    # run bare (there is no alacritty here - the X one-shot below is not
    # reached).
    exec python3 "$GEORGE_PY" "$@"
fi

SESSION="${GEORGE_TMUX_SESSION:-george}"
TMUX_CFG="$HOME/.config/george/tmux.conf"

# george arrives complete, sans DORiS: the launcher is the installer
# entry point too. It knows its own dependencies, and on Debian offers
# to fit them right here (interactive launch only - never a sudo prompt
# at login, never a surprise in a menu). Missing wmctrl degraded the bar
# quietly for three fresh installs before anyone saw why; the point of
# this block is that "window chips disabled" should never be the user's
# first clue. The kit (DORiS core.list) carries the same line - two
# layers, same truth.
want_missing() {
    MISSING=""
    python3 -c "import urwid, tomllib" 2>/dev/null || MISSING="python3-urwid"
    command -v tmux >/dev/null 2>&1 || MISSING="$MISSING tmux"
    if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        command -v alacritty >/dev/null 2>&1 || MISSING="$MISSING alacritty"
        command -v wmctrl >/dev/null 2>&1 || MISSING="$MISSING wmctrl"
        command -v xprop >/dev/null 2>&1 || MISSING="$MISSING x11-xserver-utils"
        command -v xdotool >/dev/null 2>&1 || MISSING="$MISSING xdotool"
    fi
    MISSING="${MISSING# }"
}

want_missing
if [ -n "$MISSING" ] && command -v apt-get >/dev/null 2>&1 && [ -t 0 ]; then
    printf "george needs: %s\ninstall them now [y/N]? " "$MISSING"
    read -r _ans || true
    case "${_ans:-n}" in
        y|Y*) sudo apt-get install -y $MISSING; want_missing ;;
    esac
fi

# Fatal gap (urwid): george.py cannot start at all - say it plainly, and
# say it with the apt line so the fix is copy-paste, not a scavenger hunt.
if python3 -c "import urwid, tomllib" 2>/dev/null; then :
else
    echo "george cannot run: urwid missing."
    echo "  sudo apt-get install python3-urwid"
    exit 1
fi
# ---- surface abstraction. george runs with any x-terminal-emulator,
# but alacritty is the TUNED face: there george sets WM_CLASS (so the
# openbox rule no-decorates/maximizes, and self-placement keys on it).
# Any other x-terminal-emulator is honored as a fallback on its own
# terms: title-only flags in the polite equals form (ghostty et al.
# reject space-form flags - the "title: value required" noise), no
# --class (several terminals refuse one outright). The caveat stated
# rather than swept: it may run better in alacritty - fallback windows
# are found by exact title, and -e argument grammar varies by terminal
# (konsole technically wants one string). Dashboard, chips, tmux pane
# and Ctrl+t all still work; only the styling plumbing is looser.
run_surface() { # [--detach] cmd args...  opens george's main window
    # No hard failure: callers degrade to the bare dashboard (rc 64).
    _det=""
    if [ "$1" = "--detach" ]; then _det="setsid -f"; shift; fi
    if command -v alacritty >/dev/null 2>&1; then
        exec $_det alacritty --title george --class georges -e "$@"
    elif command -v x-terminal-emulator >/dev/null 2>&1; then
        exec $_det x-terminal-emulator --title=george -e "$@"
    fi
    return 64
}

# X mode with NO terminal at all: degrade to the bare dashboard in the
# caller's terminal instead of failing the exec further down (same
# degrade ladder as tmux).
if { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } \
        && ! command -v alacritty >/dev/null 2>&1 \
        && ! command -v x-terminal-emulator >/dev/null 2>&1; then
    echo "george: no alacritty/x-terminal-emulator - plain dashboard here"
    exec python3 "$GEORGE_PY"
fi

# One-shot diagnostics (e.g. --self-test) run in a plain window, no tmux.
if [ "$#" -gt 0 ]; then
    run_surface python3 "$GEORGE_PY" "$@" || exec python3 "$GEORGE_PY" "$@"
fi

ensure_tmux_cfg() {
    if [ -f "$TMUX_CFG" ]; then
        return
    fi
    mkdir -p "$(dirname "$TMUX_CFG")"
    cat > "$TMUX_CFG" <<'TEOF'
bind -n C-t select-pane -t :.+
# terminal-pane resurrection support: the shell loop never exits, and a
# MANUALLY killed pane stays visible (remain-on-exit) so george's ▶ TERM
# chip can respawn it. No keybind to remember - the chip is the interface.
set -g remain-on-exit on
set -g status off
set -g mouse on
# The dashboard never claims mouse (urwid handle_mouse=False, keyboard-
# first) - without this, the wheel falls through to tmux and drops the
# dashboard into copy-mode scrollback (position icon top-right, borders
# restyle). Wheel over george (bare python3 exec) does nothing; the
# terminal pane keeps normal scrollback.
bind -n WheelUpPane if-shell -F '#{==:#{pane_current_command},python3}' '' 'copy-mode -e'
bind -n WheelDownPane if-shell -F '#{==:#{pane_current_command},python3}' '' 'copy-mode -e'
# 2026-09-03: superseding pair - explicit mouse-pane targeting (the pair
# above evaluated against the ACTIVE pane, so wheeling one pane could
# no-op or copy-mode another). Later binding wins.
bind -n WheelUpPane   if-shell -t '{mouse_pane}' -F '#{==:#{pane_current_command},python3}' '' 'copy-mode -e -t {mouse_pane}'
bind -n WheelDownPane if-shell -t '{mouse_pane}' -F '#{==:#{pane_current_command},python3}' '' 'copy-mode -e -t {mouse_pane}'
TEOF
}

# A session may exist while its george pane is dead (crashed / exited),
# e.g. left over from a failed earlier start. "Session exists" is NOT proof
# george is alive. Only attach if pane 0 is genuinely running george.py;
# otherwise tear it down and rebuild fresh so you never land in an orphan
# shell-with-no-dashboard.
session_healthy() {
    s="${1:-$SESSION}"
    tmux has-session -t "$s" 2>/dev/null || return 1
    # pane_start_command is the pane's ORIGINAL argv (tmux 3.5a+), immune
    # to the foreground-pgrp masking that makes pane_current_command report
    # 'bash' for shell-wrapped commands (tmux nicm pointed us here after we
    # filed the behavior; the issue is closed as working-as-designed). The
    # /proc state check stays: a stopped (SIGTSTP/SIGSTOP) or zombied
    # george passes both name checks while being a frozen ghost.
    # every read failure-tolerant: the launcher runs set -e inside a
    # BACKGROUND subshell at login, so one tmux hiccup (stale socket,
    # server dying between has-session and list-panes) used to kill the
    # whole launch SILENTLY - the reported "rare failure on successive
    # logins" (2026-09-05)
    pane_line=$(tmux list-panes -t "$s" -F '#{pane_dead} #{pane_pid} #{pane_start_command}' \
                -f '#{==:#{pane_index},0}' 2>/dev/null | head -n1 || true)
    [ -n "$pane_line" ] || return 1
    case "$pane_line" in
        "0 "*) ;;
        *) return 1 ;;
    esac
    rest=${pane_line#0 }
    pane_pid=${rest%% *}
    start_cmd=${rest#* }
    case "$start_cmd" in
        *python*) ;;
        *) return 1 ;;
    esac
    pstate=$(cut -d' ' -f3 "/proc/$pane_pid/stat" 2>/dev/null || echo "?")
    case "$pstate" in
        T|t|Z|z|?) return 1 ;;
    esac
    return 0
}

# ---- X path: attach a healthy session, rebuild a stale one. Guarded so a
# console run falls through to the console build below without ever
# touching alacritty or the X session.
if [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
    # Healthy session exists? Attach to it and keep george running
    # (detached when launched from an interactive terminal).
    if session_healthy "$SESSION"; then
        if [ -t 0 ]; then
            run_surface --detach tmux -2 -f "$TMUX_CFG" attach-session \
                -t "$SESSION" \
                </dev/null >/dev/null 2>&1 \
                || exec python3 "$GEORGE_PY"
            echo "george: attached (detached) - window opening, prompt is yours"
            exit 0
        fi
        run_surface tmux -2 -f "$TMUX_CFG" attach-session -t "$SESSION" \
            || exec python3 "$GEORGE_PY"
    fi

    # Any leftover session here is a dead/stale one - rebuild from scratch.
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        tmux kill-session -t "$SESSION" 2>/dev/null || true
    fi
fi

ensure_tmux_cfg

# Terminal pane wraps $SHELL in a loop that NEVER exits: a clean exit
# (Ctrl+d at an empty prompt) respawns a fresh prompt instantly; a nonzero
# exit (failed command + Ctrl+d, `exit 1`, a dying shell binary) just
# pauses 1s (anti-spin guard) and respawns. The old `|| exit` here turned
# ANY nonzero shell exit into a pane death - a failed command followed by
# Ctrl+d silently removed the terminal (found in daily use 2026-08-31).
# This loop cannot exit, so the pane cannot die from shell activity;
# remain-on-exit + the ▶ TERM chip cover the rest (see the tmux cfg).
RESPAWN_SHELL='while :; do '"${SHELL:-/bin/bash}"' || sleep 1; done'

# george owns its session teardown: george.py kills its own tmux session
# in run()'s finally, so the pane command is a BARE python3 exec - tmux
# runs it directly (no shell wrapper), which makes the pane's foreground
# process genuinely python3 and the health check honest. (The old compound
# `cd ... && python3; kill-session` wrapped in bash -c, whose foreground
# pgrp stays bash forever - pane_current_command never said python3 and
# the healthy-attach branch was silently dead code, found 2026-09-01.)
# A hard kill (-9) skips the teardown; the next run sees pane_dead=1 and
# rebuilds instead of attaching to a corpse.

# ---- console (tty) mode: tmux needs no X - the console itself is the
# terminal. Same architecture as the X path minus alacritty (auto-split:
# george 70% + immortal shell 30%, Ctrl+t flips, remain-on-exit). Distinct
# session name so an X george on the same tmux server is never touched;
# the session env (-e) carries GEORGE_TMUX_SESSION so george.py's ▶ TERM
# chip and its own teardown know which session is theirs.
if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    TTY_SESSION="${GEORGE_TTY_SESSION:-georgetty}"
    if session_healthy "$TTY_SESSION"; then
        exec tmux -2 -f "$TMUX_CFG" attach-session -t "$TTY_SESSION"
    fi
    if tmux has-session -t "$TTY_SESSION" 2>/dev/null; then
        tmux kill-session -t "$TTY_SESSION" 2>/dev/null || true
    fi
    ensure_tmux_cfg
    if tmux -2 -f "$TMUX_CFG" new-session \
        -e "GEORGE_TMUX_SESSION=$TTY_SESSION" \
        -d -s "$TTY_SESSION" "python3 \"$GEORGE_PY\"" \; \
        split-window -v -p 30 "$RESPAWN_SHELL" \; \
        select-pane -t :.+ \; \
        attach-session -t "$TTY_SESSION"; then
        exit 0
    fi
    # tmux build failed (rescue console, broken server) - the bare
    # dashboard still runs; a console shows stderr, so the reason is
    # visible there
    exec python3 "$GEORGE_PY"
fi

# ---- X build. Two steps, and the ORDER is the fix (2026-09-05): build
# the tmux session SERVER-SIDE first (synchronous - its exit code is the
# real verdict on a stale server / broken socket), and only then open the
# window, detached, attaching to the ready session. The old shape ran the
# build inside alacritty's -e, foreground: the launcher blocked on the
# window's whole life (terminal held - the opposite of detached) and a
# kill of the launching tree orphaned a headless george (tmux server +
# george.py outlive alacritty). Launched FROM an interactive terminal
# ([ -t 0 ]): setsid -f = new session, fds redirected, prompt handed
# straight back. No-tty launches (login hook, menu) attach foreground -
# there is no terminal to free there. A failed build DEGRADES to a plain
# george dashboard (no terminal pane) instead of vanishing, and says so
# through notify-send.
build_session() {
    tmux -2 -f "$TMUX_CFG" new-session \
        -d -e "GEORGE_TMUX_SESSION=$SESSION" \
        -s "$SESSION" \
        "python3 \"$GEORGE_PY\"" \; \
        split-window -v -p 30 "$RESPAWN_SHELL" \; \
        select-pane -t :.+
}

say_fallback() {
    command -v notify-send >/dev/null 2>&1 \
        && notify-send --hint=int:transient:1 -t 6000 "george" \
            "tmux failed - plain dashboard (no terminal pane). Reason: $1" \
        2>/dev/null || true
}

if ! build_session; then
    say_fallback "tmux build failed"
    if [ -t 0 ]; then
        if run_surface --detach python3 "$GEORGE_PY" </dev/null >/dev/null 2>&1; then
            echo "george: fallback dashboard spawned detached"
            exit 0
        fi
        exec python3 "$GEORGE_PY"
    fi
    run_surface python3 "$GEORGE_PY" || exec python3 "$GEORGE_PY"
fi

if [ -t 0 ]; then
    if run_surface --detach tmux -2 -f "$TMUX_CFG" attach-session \
            -t "$SESSION" </dev/null >/dev/null 2>&1; then
        echo "george: spawned detached - window opening, prompt is yours"
        exit 0
    fi
    exec python3 "$GEORGE_PY"
fi
run_surface tmux -2 -f "$TMUX_CFG" attach-session -t "$SESSION" \
    || exec python3 "$GEORGE_PY"
