#!/usr/bin/env bash
#machiner opencode 22 may 26
##--------------------------------------------//

MESSAGE="Hey, man, it's time"

to_seconds() {
  local num="$1"
  local unit="$2"
  case "$unit" in
    second|seconds) echo "$num" ;;
    minute|minutes|"") echo $((num * 60)) ;;
    hour|hours) echo $((num * 3600)) ;;
    *) echo $((num * 60)) ;;
  esac
}

if [ $# -eq 0 ]; then
  if ! which zenity >/dev/null 2>&1; then
    echo "Error: zenity is required for GUI mode"
    exit 1
  fi
  TIME_INPUT=$(zenity --entry --title="Reminder" --text="Remind me in..." --ok-label="Set" --entry-text="15 minutes")
  [ -z "$TIME_INPUT" ] && exit 0
  set -- $TIME_INPUT
fi

# Strip leading "me"
if [ "${1:-}" = "me" ]; then
  shift
fi

ORIG_ARGS=("$@")

# Find "in" keyword
IN_IDX=-1
for i in "${!ORIG_ARGS[@]}"; do
  if [ "${ORIG_ARGS[$i]}" = "in" ]; then
    IN_IDX=$i
    break
  fi
done

if [ $IN_IDX -ge 0 ]; then
  NUM="${ORIG_ARGS[$((IN_IDX + 1))]}"
  UNIT="${ORIG_ARGS[$((IN_IDX + 2))]:-minutes}"
elif [ ${#ORIG_ARGS[@]} -ge 1 ]; then
  NUM="${ORIG_ARGS[0]}"
  UNIT="${ORIG_ARGS[1]:-minutes}"
else
  echo "Usage: remind [me] in <N> [minutes|hours|seconds]"
  echo "       remind  (with no args to use zenity)"
  exit 1
fi

SECONDS=$(to_seconds "$NUM" "$UNIT")

echo "Reminder set: speaking in $NUM $UNIT"
sleep "$SECONDS"
espeak -v mb-en1 -s170 "$MESSAGE"
