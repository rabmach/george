#!/usr/bin/env bash
# Show battery state, charge percentage and time to full/empty.
# -w : wait for "q" before closing (used by the Super+V keybind).
wait_close=0
[ "$1" = "-w" ] && wait_close=1

batt=$(upower -e | grep -i battery | head -1)
if [ -z "$batt" ]; then
    echo "No battery found"
else
    upower -i "$batt" | grep --color=never -E "state|to full|to empty|percentage"
fi

if [ "$wait_close" = "1" ]; then
    echo
    echo "Press q to close"
    while read -rsn1 key; do
        [ "$key" = "q" ] && break
    done
fi
